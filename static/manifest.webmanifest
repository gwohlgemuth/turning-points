{
	"name": "Turning Points",
	"short_name": "Turning Points",
	"description": "Find the moments where your chess games turned.",
	"start_url": "./",
	"scope": "./",
	"display": "standalone",
	"background_color": "#0c0e13",
	"theme_color": "#0c0e13",
	"share_target": {
		"action": "./stats",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"files": [
				{
					"name": "file",
					"accept": [".txt", ".json", ".pgn", "text/plain", "application/json", "application/octet-stream"]
				}
			]
		}
	},
	"icons": [
		{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
		{ "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
	]
}
